# Copiar como .env.local en local, o como .env.production en el servidor.
# Nunca versionar el archivo con los valores reales.

# Proyecto de Supabase que guarda las tablas de la Caja.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Llave de servicio de Supabase. Ojo: salta RLS por completo, así que solo
# puede vivir en el servidor —lib/supabaseServer.ts la usa desde Server
# Components y Server Actions, nunca desde el navegador— y nunca en una
# variable con prefijo NEXT_PUBLIC_.
#
# Si alguna vez se expone por accidente (pasó el 2026-08-30 al diagnosticar un
# despliegue), hay que rotarla en Supabase → Project Settings → API y
# reiniciar el contenedor para que tome la nueva.
SUPABASE_SERVICE_ROLE_KEY=PEGAR_SERVICE_ROLE_KEY_SOLO_EN_EL_SERVIDOR

# Secreto con el que se firma la cookie de sesión (HMAC-SHA256). Una cadena
# larga y aleatoria. Si está vacía, el login redirige a /login?error=config y
# la app queda inaccesible a propósito, en vez de admitir sesiones sin firma.
#
# Cambiarla invalida todas las sesiones abiertas.
CAJA_SESSION_SECRET=CAMBIAR_POR_UN_TEXTO_LARGO_ALEATORIO

# Nota: CAJA_APP_PASSWORD ya no existe. Era el login por contraseña única de
# la primera versión; hoy el acceso es por usuario y PIN contra la tabla
# `usuarios`, y ningún archivo del código la lee. Si sigue presente en el
# .env.production del servidor, se puede retirar.
