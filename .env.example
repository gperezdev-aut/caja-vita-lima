# Variables obligatorias para Vercel y Docker Compose. Mantener los valores
# reales solo en los gestores privados de cada entorno; este archivo no lleva
# credenciales ni valores de producción.

# URL y clave de servicio de Supabase (solo servidor).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Conexión SECUNDARIA al catálogo canónico; exclusivamente server-side.
# No reemplaza SUPABASE_URL ni SUPABASE_SERVICE_ROLE_KEY de la Caja.
# Completar solo en el gestor privado del entorno. No usar NEXT_PUBLIC_*.
CATALOG_SUPABASE_URL=
CATALOG_SUPABASE_SERVICE_ROLE_KEY=
CATALOG_CANONICAL_ENABLED=false
CATALOG_EXPECTED_RELEASE_ID=catalog-v1-web-4104385
CATALOG_EXPECTED_SERVICE_COUNT=50

# Autenticación interna de Caja (solo servidor).
CAJA_APP_PASSWORD=
CAJA_SESSION_SECRET=

# Secreto compartido, solo servidor, para X-Caja-Secret en la ficha pública.
CAJA_API_SECRET=

# Datos públicos configurables que devuelve la ficha de cita.
CAJA_POLITICA_CANCELACION_URL=
CAJA_WHATSAPP_NEGOCIO=
