# Supabase
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PEGAR_SERVICE_ROLE_KEY_SOLO_EN_VERCEL

# Login simple de Caja
CAJA_APP_PASSWORD=CAMBIAR_POR_UNA_CONTRASEÑA_SEGURA
CAJA_SESSION_SECRET=CAMBIAR_POR_UN_TEXTO_LARGO_ALEATORIO

# Secreto compartido con la web pública (vita-lima-web) para
# GET/POST /api/publico/ficha/:token — cabecera X-Caja-Secret.
# Debe coincidir con el valor que use la web del otro lado.
CAJA_API_SECRET=CAMBIAR_POR_UN_TEXTO_LARGO_ALEATORIO

# URL de la política de cancelación (misma para las dos sedes) que
# devuelve el GET de la ficha de cita.
CAJA_POLITICA_CANCELACION_URL=https://CAMBIAR/politica-de-cancelacion

# Número de WhatsApp del negocio (con código de país, solo dígitos)
# para el wa.me que devuelve el POST de la ficha de cita.
CAJA_WHATSAPP_NEGOCIO=51987654321
