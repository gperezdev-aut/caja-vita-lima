# Variables obligatorias para Vercel y Docker Compose. Mantener los valores
# reales solo en los gestores privados de cada entorno; este archivo no lleva
# credenciales ni valores de producción.

# URL y clave de servicio de Supabase (solo servidor).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Autenticación interna de Caja (solo servidor).
CAJA_APP_PASSWORD=
CAJA_SESSION_SECRET=

# Secreto compartido, solo servidor, para X-Caja-Secret en la ficha pública.
CAJA_API_SECRET=

# Datos públicos configurables que devuelve la ficha de cita.
CAJA_POLITICA_CANCELACION_URL=
CAJA_WHATSAPP_NEGOCIO=
